# Django Configuration
SECRET_KEY=your-custom-django-secret-key
DEBUG=True

# Database Configuration (PostgreSQL primary)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pharmacy_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Task Broker
REDIS_URL=redis://localhost:6379/0

# Twilio SMS & WhatsApp Credentials (Optional - Falls back to console log if absent)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email Notification Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=alerts@pharmacy.com
