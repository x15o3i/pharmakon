# Django Configuration
SECRET_KEY=your-custom-django-secret-key
DEBUG=True

# Neon PostgreSQL Database Connection String
# Format: postgresql://[user]:[password]@[ep-xxx].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxx@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis & Celery Task Broker
REDIS_URL=redis://localhost:6379/0

# Twilio SMS Credentials (SMS Only)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Meta WhatsApp Cloud API Credentials (Graph API)
WHATSAPP_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=expiry_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Email Notification Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=alerts@pharmacy.com
